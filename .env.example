# ──────────────────────────────────────────────────────────────
# That's My Dawg — environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# All secret keys are SERVER-ONLY. Anything the browser may read is NEXT_PUBLIC_*.
# ──────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Database (Supabase Postgres) — pooled for app, direct for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase Storage (server-only service role)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="..."            # SERVER ONLY — never NEXT_PUBLIC
SUPABASE_STORAGE_BUCKET="dawg-uploads"

# fal.ai (the dog swap) — SERVER ONLY
FAL_KEY="..."

# Stripe — secret + webhook SERVER ONLY; publishable is public
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Printful (manual in Phase 1; API needed for Phase 2) — SERVER ONLY
PRINTFUL_API_KEY="..."

# Admin (Phase 1 manual fulfillment gate) — SERVER ONLY
ADMIN_PASSWORD="change-me"
